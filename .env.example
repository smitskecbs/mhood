# Required. Your own Solana MAINNET RPC URL (Helius, QuickNode, Alchemy, Triton, …).
# Leave empty until you have one. Do not use api.mainnet-beta.solana.com from a browser
# — public RPC returns HTTP 403. Never commit API keys.
VITE_SOLANA_RPC_URL=

# MHOOD mint (mainnet)
VITE_MHOOD_MINT=EiuaNV7T3Uz7yoVxkgxZQGXENreyBUqDWnfBLjbsYVVs

# Human-readable UI amount required to enter the forest (not raw units).
# Decimals are read from the on-chain mint account, never assumed here.
VITE_MHOOD_ACCESS_THRESHOLD=1000000

# Real mainnet burns stay disabled unless this is explicitly set to true.
# Leave false during local development so no MHOOD can be destroyed by accident.
VITE_ENABLE_REAL_BURN=false

# DEV-only. Skip the 1M holder threshold after a real wallet connect.
# Keep false so local testing uses the real on-chain gate.
VITE_DEV_BYPASS_GATE=false

# DEV-only overlay with RPC/balance details. Keep false for the normal forest UI.
VITE_SHOW_GATE_DEBUG=false

# Holder / burn ranking source: mock | indexer
# mock  = labeled development data (default, safe for local UI work)
# indexer = fetch from VITE_HOLDER_INDEXER_URL / VITE_BURN_INDEXER_URL
VITE_RANKING_SOURCE=mock

# Optional future indexer endpoints. Leave empty until a backend exists.
VITE_HOLDER_INDEXER_URL=
VITE_BURN_INDEXER_URL=

# Optional Solscan (or similar) transaction explorer prefix.
VITE_EXPLORER_TX_URL=https://solscan.io/tx/
